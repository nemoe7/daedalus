# Copy this file to .env. Daedalus skips each provider that has no API key.

# The /v1 key. Use 16 or more characters, with no spaces.
DAEDALUS_MASTER_KEY=

# Dashboard login. Empty values give the user admin and the master key as password.
DAEDALUS_USERNAME=
DAEDALUS_PASSWORD=

# Clock for the catalog schedule, for example Asia/Manila. The default is UTC.
TZ=

# Container user. Set these to your user and group IDs on Linux.
DAEDALUS_UID=1000
DAEDALUS_GID=1000

# Provider keys
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=
GEMINI_API_KEY=
# Optional: 1 key for each client in client_keys. See docs/configuration.md.
# GEMINI_API_KEY_KILO=
# GEMINI_API_KEY_OWUI=
GROQ_API_KEY=
KILO_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
POLLINATIONS_API_KEY=
ZAI_API_KEY=

# Optional compose profiles: webui, tika, search, headroom, tailscale. Separate names with commas.
# docker compose up -d then starts them.
COMPOSE_PROFILES=
# webui: a Daedalus API key from the API keys page. Empty: the master key.
OPENWEBUI_API_KEY=
# webui: a long random text. It keeps the Open WebUI logins after an image update.
WEBUI_SECRET_KEY=
# webui: the password of the Open WebUI vector database. It has no host port. Empty: openwebui.
OPENWEBUI_DB_PASSWORD=
# search: the SearXNG secret. It has no host port. Empty: no secret.
SEARXNG_SECRET=
# headroom: Daedalus sends the messages to http://headroom:8787 first. An empty value stops this.
# HEADROOM_URL=
# tailscale: an auth key from the Tailscale admin console, and the device name in your tailnet.
TS_AUTHKEY=
TS_HOSTNAME=daedalus
