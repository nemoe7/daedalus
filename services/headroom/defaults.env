# Managed Headroom defaults. Put local changes in local.env.
# Safe only while Headroom has no published host port.
HEADROOM_ALLOW_UNAUTHENTICATED_BIND=1
# Required for requests from the API container.
HEADROOM_COMPRESS_ALLOW_REMOTE=1
HEADROOM_TELEMETRY=off
HEADROOM_BEACON=off
HEADROOM_UPDATE_CHECK=off
HOME=/home/nonroot
HEADROOM_WORKSPACE_DIR=/home/nonroot/.headroom
