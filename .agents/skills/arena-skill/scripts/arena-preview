#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null)" || {
  printf '%s\n' 'Run from Git repo with installed skill' >&2
  exit 2
}
PYTHON="$HOME/.agents/.arena-preview-venv/bin/python"
if [[ ! -x "$PYTHON" ]]; then
  printf 'missing %s; run %s/scripts/install.sh from repo root\n' \
    "$PYTHON" "$REPO_ROOT/.agents/skills/arena-skill" >&2
  exit 2
fi
exec "$PYTHON" "$SCRIPT_DIR/preview.py" "$@"
