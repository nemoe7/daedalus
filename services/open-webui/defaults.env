# Managed Open WebUI defaults. Put local changes in local.env.
OPENAI_API_BASE_URL=http://api:3357/v1
ENABLE_OLLAMA_API=false
OPENAI_API_CONFIGS={"0":{"headers":{"X-OpenWebUI-Chat-Id":"{{CHAT_ID}}"}}}
ENABLE_FORWARD_USER_INFO_HEADERS=false
AIOHTTP_CLIENT_TIMEOUT=600
# The task model is a direct model name, not a routing alias.
TASK_MODEL_EXTERNAL=daedalus/auto
ENABLE_MEMORY_BACKGROUND_REVIEW=true
MEMORIES_REVIEW_INTERVAL_TURNS=5
AUDIO_STT_ENGINE=openai
AUDIO_STT_OPENAI_API_BASE_URL=http://api:3357/v1
AUDIO_STT_MODEL=daedalus/graphos
ENABLE_IMAGE_GENERATION=true
IMAGES_OPENAI_API_BASE_URL=http://api:3357/v1
IMAGE_GENERATION_MODEL=daedalus/photos
ENABLE_IMAGE_EDIT=true
IMAGE_EDIT_ENGINE=openai
IMAGES_EDIT_OPENAI_API_BASE_URL=http://api:3357/v1
IMAGE_EDIT_MODEL=daedalus/photos
# main-slim has no local embedding model. Keep files, knowledge and memory in pgvector.
VECTOR_DB=pgvector
PGVECTOR_INITIALIZE_MAX_VECTOR_LENGTH=1024
RAG_EMBEDDING_ENGINE=openai
RAG_OPENAI_API_BASE_URL=http://api:3357/v1
RAG_EMBEDDING_MODEL=mistral/mistral-embed-2312
RAG_EMBEDDING_BATCH_SIZE=32
ENABLE_ASYNC_EMBEDDING=true
RAG_EMBEDDING_CONCURRENT_REQUESTS=2
CONTENT_EXTRACTION_ENGINE=tika
TIKA_SERVER_URL=http://tika:9998
ENABLE_WEB_SEARCH=true
WEB_SEARCH_ENGINE=searxng
SEARXNG_QUERY_URL=http://searxng:8080/search?q=<query>
DEFAULT_MODEL_METADATA={"capabilities": {"file_context": true, "vision": true, "file_upload": true, "web_search": true, "image_generation": true, "code_interpreter": true, "terminal": true, "citations": true, "status_updates": true, "memory": true, "builtin_tools": true}, "defaultFeatureIds": ["web_search", "code_interpreter"]}
